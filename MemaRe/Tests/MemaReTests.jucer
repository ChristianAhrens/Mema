              headerPath="../../../../submodules/JUCE-AppBasics/Source&#10;../../../../Source"
              companyName="ChristianAhrens" companyCopyright="Copyright (c) 2024 Christian Ahrens.">
  <MAINGROUP id="mrt2mg" name="MemaReTests">
    <GROUP id="{9E9E9E9E-0003-0003-0003-000000000001}" name="Source">
      <FILE id="mrt3s1" name="Main.cpp" compile="1" resource="0" file="Source/Main.cpp"/>
      <FILE id="mrt4s2" name="SanityTest.cpp" compile="1" resource="0" file="Source/SanityTest.cpp"/>
      <FILE id="mrt5s3" name="InputPositionMapperTest.cpp" compile="1" resource="0" file="Source/InputPositionMapperTest.cpp"/>
