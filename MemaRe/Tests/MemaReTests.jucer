      <FILE id="mrt10p3" name="AppConfigurationBase.cpp" compile="1" resource="0" file="../../submodules/JUCE-AppBasics/Source/AppConfigurationBase.cpp"/>
      <!-- Embedded so MemaReAppConfiguration.cpp's ResetToDefault() resolves
           BinaryData::MemaReDefault_config, exactly like MemaRe.jucer itself does. -->
      <FILE id="mrt11p4" name="MemaReDefault.config" compile="0" resource="1" file="../../Resources/MemaReDefault.config"/>
    </GROUP>
